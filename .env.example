# 로컬용 환경변수 파일
SPRING_PROFILES_ACTIVE=local

MYSQL_DATABASE=orbit
MYSQL_USER=orbit_user
MYSQL_PASSWORD=orbit_password
MYSQL_ROOT_PASSWORD=root_password

DB_HOST=localhost
DB_PORT=3306

FASTAPI_BASE_URL=http://localhost:8000
FASTAPI_DATA_DIR=./fastapi/data

# CORS 허용 origin (콤마로 구분, FastAPI/Spring 공통 사용)
# 미설정 시 두 서버 모두 http://localhost:5173 을 기본값으로 사용합니다.
CORS_ALLOWED_ORIGINS=http://localhost:5173

# 운영(EC2) 예시 - 실제 값은 이 파일에 커밋하지 말고 EC2 systemd 서비스의
# Environment= 로 주입할 것 (아래 README/answer 참고)
# CORS_ALLOWED_ORIGINS=https://orbit-zeta-liard.vercel.app
